{
  "name": "@thecryptodonkey/hang-on-fren",
  "version": "0.1.0",
  "description": "Hang On, Fren - an endless Riviera Vespa road-tribute starring DNI. Grab roses, don't run out of time, don't wipe out.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:api": "vite build --config vite.server.config.ts && HANGONFREN_PUBLISH=0 node server-dist/index.js",
    "build": "npm run typecheck && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:migrate": "vite build --config vite.migrate.config.ts",
    "build:napplet": "tsc --noEmit && vite build --config vite.napplet.config.ts",
    "test:napplet": "napplet-conformance ./dist-napplet",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.server.json",
    "test": "vitest run",
    "test:qr": "node tools/qr-smoke.mjs",
    "gen:art": "node tools/gen-art.mjs"
  },
  "devDependencies": {
    "@napplet/conformance-cli": "0.3.4",
    "@napplet/vite-plugin": "0.16.1",
    "@types/node": "^22.20.1",
    "jsqr": "1.4.0",
    "nostr-tools": "^2.23.9",
    "playwright": "1.64.0",
    "pngjs": "7.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.9"
  },
  "license": "MIT",
  "dependencies": {
    "@forgesworn/joystick-protocol": "file:vendor/joystick/joystick-protocol-0.4.2-613408c2b830.tgz",
    "qrcode-generator": "1.5.2"
  }
}
